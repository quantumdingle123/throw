local function getTargetResolveValue(startData)
    if type(startData) == "table" then
        local serverGoal = tonumber(startData.Target or startData.SweetSpot or startData.Goal)
        if serverGoal then
            return serverGoal
        end
    end

    local throwSeq = PlayerGui:FindFirstChild("ThrowSequence")
    local meter = throwSeq and throwSeq:FindFirstChild("Meter")
    local bar = meter and meter:FindFirstChild("Bar")

    if bar then
        for _, child in ipairs(bar:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "Marker" then
                local lower = child.Name:lower()
                if lower:find("target") or lower:find("zone") or lower:find("perfect")
                or lower:find("sweet") or lower:find("green") or lower:find("area") then
                    local targetY = child.Position.Y.Scale
                    return CONFIG.Throw.InvertYScale and (1 - targetY) or targetY
                end
            end
        end
    end

    return CONFIG.Throw.FallbackValue
end

local function runThrowCycle(sessionId, phaseToken)
    local rStart = getRemote("Throw_Start")
    local rMeter = getRemote("Throw_MeterStarted")
    local rResolve = getRemote("Throw_Resolve")
    local rRevealed = getRemote("Throw_Revealed")
    local rComplete = getRemote("Throw_Complete")

    if not rStart or not rMeter or not rResolve or not rRevealed or not rComplete then
        task.wait(0.5)
        return
    end

    if not teleportRootIfNeeded(CONFIG.Throw.TargetCFrame, CONFIG.Throw.MaxDistanceStuds, CONFIG.Throw.PostTeleportWait) then
        task.wait(0.25)
        return
    end

    local _, startData = callRemote(rStart)
    task.wait(CONFIG.Throw.StepDelay)
    if not isSessionAlive(sessionId) then return end

    callRemote(rMeter)
    task.wait(CONFIG.Throw.MeterTravelWait)
    if not isSessionAlive(sessionId) then return end

    local resolveValue = getTargetResolveValue(startData)
    callRemote(rResolve, resolveValue)
    task.wait(CONFIG.Throw.StepDelay)
    if not isSessionAlive(sessionId) then return end

    callRemote(rRevealed)
    task.wait(CONFIG.Throw.StepDelay)
    if not isSessionAlive(sessionId) then return end

    callRemote(rComplete)

    if state.Desired.EquipBest and isSessionAlive(sessionId) then
        invokeEquipBest()
    end

    -- Wait for plot transition; only return to throw spot if Throw still owns the scheduler
    task.wait(CONFIG.Throw.PostCompleteDelay)
    if not isSessionAlive(sessionId) then return end
    if state.Desired.Throw and state.Farm.ActiveMode == "Throw" and state.Farm.PhaseToken == phaseToken then
        teleportRootIfNeeded(CONFIG.Throw.TargetCFrame, CONFIG.Throw.MaxDistanceStuds, CONFIG.Throw.PostTeleportWait)
    end
end

