-- Sidebar Tab: Farm
local FarmTab = Window:CreateTab("Farm", "Farm")

-- Category: Auto Farm
local CatAutoFarm = FarmTab:CreateCategory("Auto Farm", true, 1)

-- Feature: Auto Throw
CatAutoFarm:CreateToggle("Auto Throw", "Automatically teleports to throw spot and hits target meter", false, function(enabled)
    state.Running = enabled
    if enabled then
        print("[AutoThrow] Enabled.")
        Window:Notify({
            Title = "Auto Throw",
            Content = "Auto Throw enabled.",
            Duration = 2
        })
        startAutoThrowLoop()
    else
        print("[AutoThrow] Turning off after current throw finishes...")
        Window:Notify({
            Title = "Auto Throw",
            Content = "Turning off after current throw finishes...",
            Duration = 2
        })
    end
end)

