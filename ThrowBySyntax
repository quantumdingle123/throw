local function getCardsContainer()
    local foodShop = PlayerGui:FindFirstChild("FoodShop")
    local main = foodShop and foodShop:FindFirstChild("Main")
    local panel = main and main:FindFirstChild("Panel")
    local body = panel and panel:FindFirstChild("Body")
    return body and body:FindFirstChild("CardsScroll")
end

-- Returns ("BUY", nextItem), ("MAX", nil), or ("LOADING", nil)
local function evaluateFoodShop()
    local cardsScroll = getCardsContainer()
    if not cardsScroll then
        return "LOADING", nil
    end

    local totalCards = 0
    local highestOwnedId = 0
    local maxShopId = 0
    local unownedFoods = {}

    for _, card in ipairs(cardsScroll:GetChildren()) do
        local foodId = tonumber(card.Name:match("^Food(%d+)$"))
        if foodId then
            totalCards = totalCards + 1
            if foodId > maxShopId then
                maxShopId = foodId
            end

            local statusLabel = card:FindFirstChild("Label", true)
            if statusLabel and statusLabel:IsA("TextLabel") then
                local rawText = statusLabel.Text
                local upperText = rawText:gsub("%s+", ""):upper()

                if upperText == "EQUIP" or upperText == "EQUIPPED" then
                    if foodId > highestOwnedId then
                        highestOwnedId = foodId
                    end
                elseif rawText:find("%$") then
                    local cost = parseCurrency(rawText)
                    if cost and cost > 0 then
                        table.insert(unownedFoods, { id = foodId, price = cost })
                    end
                end
            end
        end
    end

    if totalCards == 0 then
        return "LOADING", nil
    end

    if highestOwnedId >= maxShopId then
        return "MAX", nil
    end

    table.sort(unownedFoods, function(a, b)
        return a.id < b.id
    end)

    for _, item in ipairs(unownedFoods) do
        if item.id > highestOwnedId then
            return "BUY", item
        end
    end

    return "LOADING", nil
end

local function startAutoFoodLoop()
    state.Tokens.Food = state.Tokens.Food + 1
    local myToken = state.Tokens.Food
    local mySession = state.SessionId

    task.spawn(function()
        while isSessionAlive(mySession) and state.Desired.Food and state.Tokens.Food == myToken do
            local okIter, status, nextFood = pcall(evaluateFoodShop)
            if okIter then
                if status == "MAX" then
                    state.Desired.Food = false
                    state.Tokens.Food = state.Tokens.Food + 1
                    if FoodToggle and type(FoodToggle.SetValue) == "function" then
                        pcall(function()
                            FoodToggle:SetValue(false, false)
                        end)
                    end
                    print("[AutoFood] All max-tier foods owned. Stopped cleanly.")
                    safeNotify("Auto Buy Food", "All max-tier foods owned! Stopped.", 3)
                    break
                end

                if status == "BUY" and nextFood then
                    local currentMoney = getCurrentMoney()
                    if currentMoney and currentMoney >= nextFood.price then
                        local rBuy = getRemote("Shop_Buy")
                        if rBuy then
                            local okCall = callRemote(rBuy, nextFood.id)
                            task.wait(okCall and CONFIG.Food.PostBuyDelay or CONFIG.Food.CheckInterval)
                            continue
                        end
                    end
                end
            end

            task.wait(CONFIG.Food.CheckInterval)
        end
    end)
end

