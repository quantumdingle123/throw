local function triggerGuiButton(button)
    if not button or not button:IsA("GuiButton") then
        return
    end

    local signals = { button.Activated, button.MouseButton1Click, button.MouseButton1Down }
    local firedCount = 0

    if type(getconnections) == "function" then
        for _, signal in ipairs(signals) do
            local okList, conns = pcall(getconnections, signal)
            if okList and type(conns) == "table" then
                for _, conn in ipairs(conns) do
                    if conn.Enabled and conn.Function then
                        local okFire = pcall(function()
                            conn:Fire()
                        end)
                        if okFire then
                            firedCount = firedCount + 1
                        end
                    end
                end
            end
        end
    end

    if firedCount == 0 and type(firesignal) == "function" then
        for _, signal in ipairs(signals) do
            pcall(firesignal, signal)
        end
    end
end

local function isTrainTokenActive(sessionId, phaseToken)
    return isSessionAlive(sessionId)
        and state.Desired.Train
        and state.Farm.ActiveMode == "Train"
        and state.Farm.PhaseToken == phaseToken
end

local function handleTapBonusButton(btn, sessionId, phaseToken)
    if not isTrainTokenActive(sessionId, phaseToken) then
        return
    end
    if not btn or btn.Name ~= "TapBonus" or not btn:IsA("GuiButton") then
        return
    end

    local lastTapClock = 0

    local function claimWhenVisible()
        if not isTrainTokenActive(sessionId, phaseToken) then
            return
        end
        if not btn.Parent or not btn.Visible then
            return
        end

        task.delay(CONFIG.Train.TapReactionDelay, function()
            if not isTrainTokenActive(sessionId, phaseToken) then
                return
            end
            if btn.Parent and btn.Visible then
                local now = os.clock()
                if now - lastTapClock < CONFIG.Train.TapCooldown then
                    return
                end
                lastTapClock = now
                triggerGuiButton(btn)
            end
        end)
    end

    if btn.Visible then
        claimWhenVisible()
    end

    local visConn, ancConn
    visConn = btn:GetPropertyChangedSignal("Visible"):Connect(claimWhenVisible)
    ancConn = btn.AncestryChanged:Connect(function(_, newParent)
        if newParent == nil then
            if visConn then pcall(function() visConn:Disconnect() end) end
            if ancConn then pcall(function() ancConn:Disconnect() end) end
        end
    end)
    table.insert(state.Farm.TrainConnections, visConn)
    table.insert(state.Farm.TrainConnections, ancConn)
end

local function setupQteWatcher(sessionId, phaseToken)
    if state.Farm.WatcherPhaseToken == phaseToken then
        return
    end
    state.Farm.WatcherPhaseToken = phaseToken
    local ok, err = pcall(function()
        disconnectAll(state.Farm.TrainConnections)
        state.Farm.AttachedBonusLayer = nil

        local trainingSeq = PlayerGui:FindFirstChild("TrainingSequence") or PlayerGui:WaitForChild("TrainingSequence", 3)
        local bonusLayer = trainingSeq and (trainingSeq:FindFirstChild("TapBonusLayer") or trainingSeq:WaitForChild("TapBonusLayer", 3))
        if not bonusLayer or not isTrainTokenActive(sessionId, phaseToken) then
            return
        end

        state.Farm.AttachedBonusLayer = bonusLayer
        for _, child in ipairs(bonusLayer:GetChildren()) do
            handleTapBonusButton(child, sessionId, phaseToken)
        end

        local childConn = bonusLayer.ChildAdded:Connect(function(child)
            handleTapBonusButton(child, sessionId, phaseToken)
        end)
        table.insert(state.Farm.TrainConnections, childConn)
    end)
    if state.Farm.WatcherPhaseToken == phaseToken then
        state.Farm.WatcherPhaseToken = nil
    end
    if not ok then
        warn("[AutoTrain] QTE watcher error: " .. tostring(err))
    end
end

local function getPullUpStandCFrame()
    local plotIndex = LocalPlayer:GetAttribute("PlotIndex")
    if plotIndex == nil then
        if not state.Farm.MissingStandWarned then
            state.Farm.MissingStandWarned = true
            warn("[AutoTrain] PlotIndex attribute is nil.")
        end
        return nil
    end

    local plotsFolder = Workspace:FindFirstChild("Plots")
    local myPlot = plotsFolder and plotsFolder:FindFirstChild(tostring(plotIndex))
    local serverFolder = myPlot and myPlot:FindFirstChild("Server")
    local pullUpStand = serverFolder and serverFolder:FindFirstChild("PullUpStand")
    if not pullUpStand then
        if not state.Farm.MissingStandWarned then
            state.Farm.MissingStandWarned = true
            warn("[AutoTrain] PullUpStand not found in Plot " .. tostring(plotIndex))
        end
        return nil
    end

    state.Farm.MissingStandWarned = false
    local baseCFrame = nil
    if pullUpStand:IsA("Model") then
        baseCFrame = pullUpStand:GetPivot()
    elseif pullUpStand:IsA("BasePart") then
        baseCFrame = pullUpStand.CFrame
    end
    if not baseCFrame then
        return nil
    end
    return baseCFrame * CONFIG.Train.StandOffset
end

local function stopTrainPhase(sendStopRemote)
    disconnectAll(state.Farm.TrainConnections)
    state.Farm.AttachedBonusLayer = nil
    if state.Farm.TrainStarted then
        state.Farm.TrainStarted = false
        if sendStopRemote then
            local rStop = getRemote("Training_Stop")
            if rStop then
                callRemote(rStop)
            end
        end
    end
end

-- ==============================================================================
-- [ UNIFIED FARM SCHEDULER (AUTO THROW <-> AUTO TRAIN) ]
-- ==============================================================================
local function beginPhase(mode, notifyMsg)
    state.Farm.ActiveMode = mode
    state.Farm.PhaseToken = state.Farm.PhaseToken + 1
    state.Farm.PhaseStart = os.clock()
    state.Farm.ResetCountdownRequested = false
    if notifyMsg then
        safeNotify("Auto Farm", notifyMsg, 2.5)
    end
    return state.Farm.PhaseToken
end

local function runThrowPhase(mySession)
    local phaseToken = beginPhase("Throw", nil)
    print("[AutoThrow] Active.")

    while isSessionAlive(mySession) and state.Desired.Throw and state.Farm.ActiveMode == "Throw" do
        if state.Farm.ResetCountdownRequested then
            state.Farm.PhaseStart = os.clock()
            state.Farm.ResetCountdownRequested = false
        end

        if state.Desired.Train then
            local throwLimitSec = getConfiguredMinutes("Throw") * 60
            if (os.clock() - state.Farm.PhaseStart) >= throwLimitSec then
                break
            end
        end

        runThrowCycle(mySession, phaseToken)

        if state.Desired.Train and state.Desired.Throw then
            local throwLimitSec = getConfiguredMinutes("Throw") * 60
            if (os.clock() - state.Farm.PhaseStart) >= throwLimitSec then
                break
            end
        end
    end
end

local function runTrainPhase(mySession, initialTimed)
    local timed = (initialTimed == true)
    local msg = timed and string.format("Switching to Auto Train (%s min)...", formatMinutes(getConfiguredMinutes("Train"))) or nil
    local trainToken = beginPhase("Train", msg)
    print("[AutoTrain] Active.")
    state.Farm.MissingStandWarned = false
    state.Farm.TrainStarted = true
    teleportRootIfNeeded(getPullUpStandCFrame(), CONFIG.Train.MaxDistanceStuds, 0)
    task.spawn(setupQteWatcher, mySession, trainToken)

    while isSessionAlive(mySession) and state.Desired.Train and state.Farm.ActiveMode == "Train" do
        if state.Farm.WatcherPhaseToken ~= trainToken
           and (not state.Farm.AttachedBonusLayer or not state.Farm.AttachedBonusLayer:IsDescendantOf(PlayerGui)) then
            task.spawn(setupQteWatcher, mySession, trainToken)
        end

        if not state.Desired.Throw then
            -- Dropped to solo Train mode; if Throw is re-enabled later, switch cleanly to Throw first
            timed = false
            teleportRootIfNeeded(getPullUpStandCFrame(), CONFIG.Train.MaxDistanceStuds, 0)
            task.wait(CONFIG.Train.MonitorInterval)
        elseif not timed then
            -- Solo Train while Throw was just turned ON -> yield to Throw first
            break
        else
            local trainLimitSec = getConfiguredMinutes("Train") * 60
            local remaining = trainLimitSec - (os.clock() - state.Farm.PhaseStart)
            if remaining <= 0 then
                break
            end
            teleportRootIfNeeded(getPullUpStandCFrame(), CONFIG.Train.MaxDistanceStuds, 0)
            task.wait(math.min(CONFIG.Train.MonitorInterval, math.max(0.1, remaining)))
        end
    end

    stopTrainPhase(true)
end

local function startFarmSchedulerIfNeeded()
    if state.Farm.SchedulerRunning then
        return
    end

    local mySession = state.SessionId
    state.Farm.SchedulerRunning = true

    task.spawn(function()
        while isSessionAlive(mySession) and (state.Desired.Throw or state.Desired.Train) do
            local okPhase, errPhase = pcall(function()
                if state.Desired.Throw then
                    runThrowPhase(mySession)
                    if isSessionAlive(mySession) and state.Desired.Throw and state.Desired.Train then
                        runTrainPhase(mySession, true)
                        if isSessionAlive(mySession) and state.Desired.Throw and state.Desired.Train then
                            safeNotify(
                                "Auto Farm",
                                string.format("Switching to Auto Throw (%s min)...", formatMinutes(getConfiguredMinutes("Throw"))),
                                2.5
                            )
                        end
                    end
                else
                    runTrainPhase(mySession, false)
                end
            end)

            if not okPhase then
                warn("[AutoFarm] Phase error: " .. tostring(errPhase))
                stopTrainPhase(true)
                task.wait(1)
            end
        end

        stopTrainPhase(true)
        if state.SessionId == mySession then
            state.Farm.ActiveMode = nil
            state.Farm.SchedulerRunning = false
        end
        print("[AutoFarm] Scheduler stopped cleanly.")
    end)
end

