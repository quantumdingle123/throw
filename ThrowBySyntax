local function isEffectivelyVisible(guiObj, stopAt)
    local cur = guiObj
    while cur and cur ~= stopAt do
        if cur:IsA("GuiObject") and not cur.Visible then
            return false
        elseif cur:IsA("LayerCollector") and not cur.Enabled then
            return false
        end
        cur = cur.Parent
    end
    return true
end

local function getStandUpgradeRoots()
    local searchRoots = {}

    local plotIndex = LocalPlayer:GetAttribute("PlotIndex")
    if plotIndex ~= nil then
        local plotsFolder = Workspace:FindFirstChild("Plots")
        local myPlot = plotsFolder and plotsFolder:FindFirstChild(tostring(plotIndex))
        local serverFolder = myPlot and myPlot:FindFirstChild("Server")
        local pullUpStand = serverFolder and serverFolder:FindFirstChild("PullUpStand")
        if pullUpStand then
            table.insert(searchRoots, pullUpStand)
        end
    end

    local localProps = Workspace:FindFirstChild("LocalPlotProps")
    local trainingArea = localProps and localProps:FindFirstChild("TrainingArea")
    if trainingArea then
        table.insert(searchRoots, trainingArea)
    end

    return searchRoots
end

local function getPlotUpgradeRoots()
    local localProps = Workspace:FindFirstChild("LocalPlotProps")
    local upgradeSign = localProps and localProps:FindFirstChild("PlotUpgradeSign")
    if upgradeSign then
        return { upgradeSign }
    end
    return {}
end

local function inspectSignRoots(getRootsFn)
    local searchRoots = getRootsFn()
    local firstPrice = nil

    for _, root in ipairs(searchRoots) do
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("TextLabel") and isEffectivelyVisible(desc, root) then
                local text = desc.Text
                local trimmedUpper = text:match("^%s*(.-)%s*$"):upper()
                if trimmedUpper == "MAX" or trimmedUpper == "MAXED" or trimmedUpper == "MAX LEVEL" then
                    return "MAX", nil
                end
                if not firstPrice and text:find("%$") then
                    local cost = parseCurrency(text)
                    if cost and cost > 0 then
                        firstPrice = cost
                    end
                end
            end
        end
    end

    if firstPrice then
        return "PRICE", firstPrice
    end

    return "NONE", nil
end

local function startSignUpgradeLoop(opts)
    local desiredKey = opts.DesiredKey
    local tokenKey = opts.TokenKey
    state.Tokens[tokenKey] = state.Tokens[tokenKey] + 1
    local myToken = state.Tokens[tokenKey]
    local mySession = state.SessionId

    task.spawn(function()
        local sameCount = 0
        local lastCost = nil
        local lastMoney = nil

        while isSessionAlive(mySession) and state.Desired[desiredKey] and state.Tokens[tokenKey] == myToken do
            local okIter, signStatus, upgradeCost = pcall(inspectSignRoots, opts.GetRoots)
            if okIter then
                if signStatus == "MAX" then
                    state.Desired[desiredKey] = false
                    state.Tokens[tokenKey] = state.Tokens[tokenKey] + 1
                    local toggleObj = opts.GetToggle and opts.GetToggle()
                    if toggleObj and type(toggleObj.SetValue) == "function" then
                        pcall(function()
                            toggleObj:SetValue(false, false)
                        end)
                    end
                    print(string.format("[%s] Max level reached. Stopped cleanly.", opts.LogTag))
                    safeNotify(opts.Label, "Max level reached! " .. opts.Label .. " stopped.", 3)
                    break
                end

                if signStatus == "PRICE" and upgradeCost then
                    local currentMoney = getCurrentMoney()
                    if currentMoney and currentMoney >= upgradeCost then
                        if lastCost == upgradeCost and lastMoney == currentMoney then
                            sameCount = sameCount + 1
                        else
                            sameCount = 0
                        end
                        lastCost = upgradeCost
                        lastMoney = currentMoney

                        local remote = getRemote(opts.RemoteName)
                        if remote then
                            local okCall = callRemote(remote)
                            local waitSec = okCall and math.max(0.5, opts.PostDelay) or opts.CheckInterval
                            if sameCount >= 3 then
                                waitSec = 5.0
                            end
                            task.wait(waitSec)
                            continue
                        end
                    else
                        sameCount = 0
                    end
                else
                    sameCount = 0
                end
            end

            task.wait(opts.CheckInterval)
        end
    end)
end

