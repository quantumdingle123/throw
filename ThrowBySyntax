local function isSessionAlive(sessionId)
    return (not state.IsShutDown)
        and state.SessionId == sessionId
        and state.Window ~= nil
        and state.Window.Context ~= nil
        and state.Window.Context.IsAlive == true
end

local function disconnectAll(connList)
    for i = #connList, 1, -1 do
        local conn = connList[i]
        connList[i] = nil
        if conn then
            pcall(function()
                if conn.Connected ~= false then
                    conn:Disconnect()
                end
            end)
        end
    end
end

local function safeNotify(title, content, duration)
    if state.Window and state.Window.Context and state.Window.Context.IsAlive then
        pcall(function()
            state.Window:Notify({
                Title = title,
                Content = content,
                Duration = duration or 2
            })
        end)
    end
end

local function parseMinutes(rawText, fallback)
    local fb = fallback or DEFAULT_MINUTES
    local str = tostring(rawText or ""):match("^%s*(.-)%s*$")
    local n = tonumber(str)
    if not n or n ~= n or math.abs(n) == math.huge or n <= 0 then
        return fb, false
    end
    if n < MIN_MINUTES then
        return MIN_MINUTES, true
    end
    if n > MAX_MINUTES then
        return MAX_MINUTES, true
    end
    return n, true
end

local function formatMinutes(mins)
    if math.abs(mins - math.floor(mins + 0.5)) < 1e-6 then
        return tostring(math.floor(mins + 0.5))
    end
    local formatted = string.format("%.2f", mins):gsub("0+$", ""):gsub("%.$", "")
    return formatted
end

local function getConfiguredMinutes(mode)
    local box = (mode == "Throw") and ThrowTimeBox or TrainTimeBox
    local fallback = state.Minutes[mode] or DEFAULT_MINUTES
    if box and type(box.GetValue) == "function" then
        local parsed, ok = parseMinutes(box:GetValue(), fallback)
        if ok then
            state.Minutes[mode] = parsed
            return parsed
        end
    end
    return fallback
end

local function getRemote(name)
    local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 2)
    if not remotesFolder then
        return nil
    end
    return remotesFolder:FindFirstChild(name) or remotesFolder:WaitForChild(name, 2)
end

local function callRemote(remote, ...)
    if not remote then
        return false, nil
    end
    local args = table.pack(...)
    if remote:IsA("RemoteFunction") then
        return pcall(function()
            return remote:InvokeServer(table.unpack(args, 1, args.n))
        end)
    elseif remote:IsA("RemoteEvent") then
        return pcall(function()
            remote:FireServer(table.unpack(args, 1, args.n))
        end)
    end
    return false, nil
end

local function teleportRootIfNeeded(targetCFrame, maxDistStuds, postWait)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart or not targetCFrame then
        return false
    end

    if (rootPart.Position - targetCFrame.Position).Magnitude > maxDistStuds then
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        rootPart.CFrame = targetCFrame
        if postWait and postWait > 0 then
            task.wait(postWait)
        end
    end

    return true
end

-- Converts shorthand currency strings (e.g. "$650M", "$3.2B", "$31Ocd") into numbers
local function parseCurrency(text)
    if type(text) ~= "string" then
        return nil
    end

    local lower = text:lower()
    if lower:find("/s", 1, true) then
        return nil
    end

    local cleaned = lower:gsub("[%$,%s]", "")
    local numStr, suffix = cleaned:match("^(%d+%.?%d*)(%a*)$")
    local baseNum = tonumber(numStr)
    if not baseNum then
        return nil
    end

    if suffix == "" then
        return baseNum
    end

    local mult = MULTIPLIERS[suffix]
    return mult and (baseNum * mult) or nil
end

local function getCurrentMoney()
    local statsGui = PlayerGui:FindFirstChild("StatsGui")
    local container = statsGui and statsGui:FindFirstChild("Container")
    local moneyDisplay = container and container:FindFirstChild("MoneyDisplay")
    local valueLabel = moneyDisplay and moneyDisplay:FindFirstChild("ValueLabel")

    if valueLabel and valueLabel:IsA("TextLabel") then
        return parseCurrency(valueLabel.Text)
    end

    return nil
end

