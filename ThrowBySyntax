local function startAutoEquipBestLoop()
    state.Tokens.EquipBest = state.Tokens.EquipBest + 1
    local myToken = state.Tokens.EquipBest
    local mySession = state.SessionId

    task.spawn(function()
        local nextEquipAt = os.clock()
        while isSessionAlive(mySession) and state.Desired.EquipBest and state.Tokens.EquipBest == myToken do
            if state.Desired.Throw then
                -- Auto Throw handles equipping after each completed throw sequence
                nextEquipAt = os.clock() + CONFIG.EquipBest.Interval
            elseif os.clock() >= nextEquipAt then
                invokeEquipBest()
                nextEquipAt = os.clock() + CONFIG.EquipBest.Interval
            end

            task.wait(1)
        end
    end)
end

-- ==============================================================================
-- [ TEARDOWN / SHUTDOWN ]
-- ==============================================================================
function state.Shutdown()
    if state.IsShutDown then
        return
    end
    state.IsShutDown = true
    state.Desired.Throw = false
    state.Desired.Train = false
    state.Desired.Upgrade = false
    state.Desired.PlotUpgrade = false
    state.Desired.Food = false
    state.Desired.EquipBest = false
    state.SessionId = state.SessionId + 1
    state.Farm.PhaseToken = state.Farm.PhaseToken + 1
    state.Tokens.Upgrade = state.Tokens.Upgrade + 1
    state.Tokens.PlotUpgrade = state.Tokens.PlotUpgrade + 1
    state.Tokens.Food = state.Tokens.Food + 1
    state.Tokens.EquipBest = state.Tokens.EquipBest + 1

    disconnectAll(state.Farm.TrainConnections)
    if state.Farm.TrainStarted then
        state.Farm.TrainStarted = false
        task.spawn(function()
            local rStop = getRemote("Training_Stop")
            if rStop then
                callRemote(rStop)
            end
        end)
    end

    if state.Window and type(state.Window.Destroy) == "function" then
        local w = state.Window
        state.Window = nil
        pcall(function()
            w:Destroy()
        end)
    end
end
env.ThrowBySyntaxState = state

